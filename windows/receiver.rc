#include <winver.h>
101 ICON "monitor.ico"

// Resource metadata does not replace Authenticode signing, but makes the
// executable identifiable in Windows Explorer / security inspection.
1 VERSIONINFO
FILEVERSION 0,23,0,0
PRODUCTVERSION 0,23,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Karin Laboratory"
            VALUE "FileDescription", "MyCast Receiver - LAN screen and audio viewer"
            VALUE "FileVersion", "0.23.0.0"
            VALUE "InternalName", "MyCastReceiver"
            VALUE "OriginalFilename", "mycastreceiver023.exe"
            VALUE "ProductName", "MyMonitor / MyCast Receiver"
            VALUE "ProductVersion", "0.23"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
